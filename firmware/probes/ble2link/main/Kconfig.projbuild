menu "ble2link probe"
    choice B2L_ROLE
        prompt "Role"
        default B2L_CENTRAL
        config B2L_CENTRAL
            bool "Central (connects both peripherals)"
        config B2L_P1
            bool "Peripheral 1"
        config B2L_P2
            bool "Peripheral 2"
    endchoice
endmenu
