{
  "version": 1,
  "title": "PalmPilot HUB: CALIBRATE button, USB-UART to laptop",
  "notes": "PalmPilot HUB, bench plan on a half breadboard. Pins match PalmPilot CLAUDE.md section 2; not checked on hardware. Laptop link: USB data cable from the DevKit port labelled UART (on-board USB-to-UART bridge on UART0, 115200 baud) to the laptop; it also powers the hub. GPIO43 (U0TXD) and GPIO44 (U0RXD) are highlighted because the bridge uses them: do not wire them. No flex sensors and no motion sensor on the hub. Hands reach the hub over BLE only. Do not use GPIO0/3/45/46 (strapping), GPIO19/20 (native USB), GPIO43/44 (UART0 bridge). GPIO10 is reserved for battery sense: leave it disconnected.",
  "parts": [
    {
      "id": "bb",
      "board": "breadboard-half",
      "x": 0,
      "y": 0
    },
    {
      "id": "esp",
      "board": "esp32-s3-devkitc-1",
      "x": 4,
      "y": 62,
      "label": "HUB ESP32-S3-DevKitC-1 (USB-UART port -> laptop, 115200)"
    }
  ],
  "connections": [
    {
      "from": "esp:J1-1",
      "to": "bb:BP2",
      "color": "red",
      "label": "HUB 3V3 -> bottom + rail"
    },
    {
      "from": "esp:J3-1",
      "to": "bb:BN10",
      "color": "black",
      "label": "HUB GND -> bottom - rail"
    },
    {
      "from": "bb:BP24",
      "to": "bb:TP24",
      "color": "red",
      "label": "bottom + rail -> top + rail"
    },
    {
      "from": "bb:BN24",
      "to": "bb:TN24",
      "color": "black",
      "label": "bottom - rail -> top - rail"
    },
    {
      "from": "bb:TP10",
      "to": "bb:14a",
      "component": "resistor",
      "value": "10k",
      "label": "HUB 3V3 -> 10k -> CALIBRATE node (pull-up)"
    },
    {
      "from": "bb:14b",
      "to": "bb:TN14",
      "component": "capacitor",
      "value": "100nF",
      "label": "CALIBRATE node -> 100nF -> GND (debounce)"
    },
    {
      "from": "bb:14d",
      "to": "bb:19d",
      "component": "resistor",
      "value": "1k",
      "label": "CALIBRATE node -> 1k -> switch"
    },
    {
      "from": "bb:19a",
      "to": "bb:TN16",
      "component": "button",
      "value": "CALIBRATE",
      "label": "normally-open CALIBRATE switch -> GND"
    },
    {
      "from": "bb:14e",
      "to": "esp:GPIO7",
      "color": "lime",
      "label": "CALIBRATE node -> GPIO7, active low"
    }
  ],
  "highlight": [
    "esp:GPIO43",
    "esp:GPIO44"
  ]
}
