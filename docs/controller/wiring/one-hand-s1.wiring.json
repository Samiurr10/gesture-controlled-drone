{
  "version": 1,
  "title": "PalmPilot one hand on the bench (S1-A acquisition, S1-B calibration)",
  "notes": "PalmPilot LEFT hand, bench plan. Pins match PalmPilot CLAUDE.md section 2 and docs/controller/build-guide.md; not checked on hardware. Own-board 3V3/GND only; never join supplies across boards. Flex blocks stand for flex + 47k + 100nF; button block for 10k / 100nF / 1k + NO switch. IMU: leave 3Vo, INT1/INT2/INTM/DRDY and the address pads unconnected. GPIO10 is reserved for battery sense: leave it disconnected. Do not use GPIO0/3/45/46 (strapping), GPIO19/20 (native USB), GPIO43/44 (UART0 bridge). ENABLE on GPIO7 is LEFT only.",
  "parts": [
    {
      "id": "esp",
      "board": "esp32-s3-devkitc-1",
      "x": 0,
      "y": 0,
      "label": "LEFT hand ESP32-S3-DevKitC-1"
    },
    {
      "id": "thumb",
      "board": "flex-divider-47k",
      "x": 38,
      "y": 4,
      "label": "LEFT thumb flex"
    },
    {
      "id": "index",
      "board": "flex-divider-47k",
      "x": 38,
      "y": 26,
      "label": "LEFT index flex"
    },
    {
      "id": "middle",
      "board": "flex-divider-47k",
      "x": -80,
      "y": 0,
      "label": "LEFT middle flex"
    },
    {
      "id": "ring",
      "board": "flex-divider-47k",
      "x": -80,
      "y": 22,
      "label": "LEFT ring flex"
    },
    {
      "id": "little",
      "board": "flex-divider-47k",
      "x": -80,
      "y": 44,
      "label": "LEFT little flex"
    },
    {
      "id": "imu",
      "board": "adafruit-5543",
      "x": -58,
      "y": 90,
      "label": "LEFT Adafruit #5543 (0x6A / 0x1C)"
    },
    {
      "id": "button",
      "board": "button-active-low-rc",
      "x": -80,
      "y": 66,
      "label": "LEFT ENABLE button (active low)"
    }
  ],
  "connections": [
    {
      "from": "thumb:SIG",
      "to": "esp:GPIO1",
      "color": "orange",
      "label": "thumb flex -> GPIO1 (ADC1_CH0)",
      "bend": 5.6
    },
    {
      "from": "esp:J1-2",
      "to": "thumb:3V3",
      "color": "red",
      "label": "LEFT 3V3 -> thumb flex",
      "bend": -14
    },
    {
      "from": "esp:J3-1",
      "to": "thumb:GND",
      "color": "black",
      "label": "thumb 47k + 100nF -> LEFT GND",
      "bend": 5.8
    },
    {
      "from": "index:SIG",
      "to": "esp:GPIO2",
      "color": "green",
      "label": "index flex -> GPIO2 (ADC1_CH1)",
      "bend": -5.6
    },
    {
      "from": "esp:J1-2",
      "to": "index:3V3",
      "color": "red",
      "label": "LEFT 3V3 -> index flex",
      "bend": -14
    },
    {
      "from": "esp:J3-1",
      "to": "index:GND",
      "color": "black",
      "label": "index 47k + 100nF -> LEFT GND",
      "bend": 6.3
    },
    {
      "from": "middle:SIG",
      "to": "esp:GPIO4",
      "color": "purple",
      "label": "middle flex -> GPIO4 (ADC1_CH3)",
      "bend": -8.5
    },
    {
      "from": "esp:J1-1",
      "to": "middle:3V3",
      "color": "red",
      "label": "LEFT 3V3 -> middle flex",
      "bend": 8.7
    },
    {
      "from": "esp:J1-22",
      "to": "middle:GND",
      "color": "black",
      "label": "middle 47k + 100nF -> LEFT GND",
      "bend": 10
    },
    {
      "from": "ring:SIG",
      "to": "esp:GPIO5",
      "color": "teal",
      "label": "ring flex -> GPIO5 (ADC1_CH4)",
      "bend": 8.4
    },
    {
      "from": "esp:J1-1",
      "to": "ring:3V3",
      "color": "red",
      "label": "LEFT 3V3 -> ring flex",
      "bend": -8.8
    },
    {
      "from": "esp:J1-22",
      "to": "ring:GND",
      "color": "black",
      "label": "ring 47k + 100nF -> LEFT GND",
      "bend": 9.2
    },
    {
      "from": "little:SIG",
      "to": "esp:GPIO6",
      "color": "pink",
      "label": "little flex -> GPIO6 (ADC1_CH5)",
      "bend": 8.9
    },
    {
      "from": "esp:J1-1",
      "to": "little:3V3",
      "color": "red",
      "label": "LEFT 3V3 -> little flex",
      "bend": -9.8
    },
    {
      "from": "esp:J1-22",
      "to": "little:GND",
      "color": "black",
      "label": "little 47k + 100nF -> LEFT GND",
      "bend": 8.2
    },
    {
      "from": "esp:J1-2",
      "to": "imu:VIN",
      "color": "red",
      "label": "LEFT 3V3 -> IMU VIN",
      "bend": -16
    },
    {
      "from": "esp:J1-22",
      "to": "imu:GND",
      "color": "black",
      "label": "LEFT GND -> IMU GND",
      "bend": -16
    },
    {
      "from": "esp:GPIO8",
      "to": "imu:SDA",
      "color": "blue",
      "label": "I2C SDA <-> GPIO8 (breakout pull-ups)",
      "bend": -16
    },
    {
      "from": "esp:GPIO9",
      "to": "imu:SCL",
      "color": "yellow",
      "label": "I2C SCL GPIO9 -> IMU (100 kHz)",
      "bend": -16
    },
    {
      "from": "button:OUT",
      "to": "esp:GPIO7",
      "color": "lime",
      "label": "ENABLE -> GPIO7, active low (10k pull-up)",
      "bend": 9.9
    },
    {
      "from": "esp:J1-1",
      "to": "button:3V3",
      "color": "red",
      "label": "LEFT 3V3 -> 10k pull-up",
      "bend": -10
    },
    {
      "from": "esp:J1-22",
      "to": "button:GND",
      "color": "black",
      "label": "100nF + switch -> LEFT GND",
      "bend": -8.1
    }
  ]
}
